---
import BaseLayout from "./BaseLayout.astro";
import WikilinkList from "../components/WikilinkList.astro";
import type { Lang } from "../i18n/translations";
import { seriesNames, categoryNames } from "../i18n/translations";
import { t, formatDate, getLangFromUrl, localizedPath } from "../i18n/utils";
import { switchLangPath } from "../i18n/utils";
import type { WikilinkTarget } from "../lib/wikilinks";

  interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  image?: {
    url: string;
    alt: string;
  };
  type?: "core" | "marginalia";
  series?: string;
  noteId?: string;
  category?: string;
  lang?: Lang;
  hasTranslation?: boolean;
  baseSlug?: string;
  outlinks?: WikilinkTarget[];
  backlinks?: WikilinkTarget[];
  previewData?: Record<string, { title: string; description: string; excerpt: string }>;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = "Anonymous",
  tags = [],
  image,
  type = "core",
  series,
  noteId,
  category,
  hasTranslation = false,
  baseSlug,
  outlinks = [],
  backlinks = [],
  previewData = {},
} = Astro.props;

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const otherLang: Lang = lang === "zh" ? "en" : "zh";
const switchHref = hasTranslation && baseSlug
  ? `/${otherLang}/posts/${baseSlug}`
  : null;
const seriesMap = seriesNames[lang];
const categoryMap = categoryNames[lang];

const formattedPubDate = formatDate(pubDate, lang);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate, lang) : null;

const seriesLabel = series ? seriesMap[series] || series : null;
const categoryLabel = category ? categoryMap[category] || category : null;

const switchLabel = t(lang, "lang.switch");
---

<BaseLayout
  title={title}
  description={description}
  image={image?.url}
  article={true}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
  lang={lang}
>
  <div class="reading-progress" id="reading-progress"></div>
  <article class="container-narrow py-12 md:py-16">
    <header class="mb-10">
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>
          {formattedPubDate}
        </time>
        {formattedUpdatedDate && (
          <span>{t(lang, "posts.updated")} {formattedUpdatedDate}</span>
        )}
        {type === "core" && seriesLabel && (
          <span class="meta-series">{seriesLabel}</span>
        )}
        {type === "core" && noteId && (
          <span class="meta-noteid">{noteId}</span>
        )}
        {type === "marginalia" && categoryLabel && (
          <span class="meta-category">{categoryLabel}</span>
        )}
      </div>

      <div class="article-title-row">
        <h1 class="article-title">
          {title}
        </h1>
        {switchHref && (
          <a
            href={switchHref}
            class="translate-btn"
            aria-label={`Switch to ${otherLang === "en" ? "English" : "中文"}`}
          >
            <svg class="translate-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 8l6 6" />
              <path d="M4 14l6-6 2-3" />
              <path d="M2 5h12" />
              <path d="M7 2v3" />
              <path d="M22 22l-5-10-5 10" />
              <path d="M14 18h6" />
            </svg>
            {switchLabel}
          </a>
        )}
      </div>
      
      <p class="article-desc">
        {description}
      </p>
    </header>
    
    {image && (
      <figure class="mb-12">
        <img
          src={image.url}
          alt={image.alt}
          class="w-full rounded-sm"
        />
        {image.alt && (
          <figcaption class="text-center text-sm text-[var(--color-text-muted)] mt-3">
            {image.alt}
          </figcaption>
        )}
      </figure>
    )}
    
    <div class="prose">
      <slot />
    </div>

    <WikilinkList outlinks={outlinks} backlinks={backlinks} lang={lang} />

    <script type="application/json" id="wikilink-previews" set:html={JSON.stringify(previewData)}></script>
    <div id="wikilink-preview-card" class="wikilink-preview" aria-hidden="true">
      <div class="preview-title"></div>
      <div class="preview-desc"></div>
      <div class="preview-excerpt"></div>
    </div>
    
    <footer class="mt-16 pt-8 border-t border-[var(--color-border)]">
      <div class="flex items-center justify-between">
        <a
          href={localizedPath(lang, "/")}
          class="inline-flex items-center gap-2 text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors text-sm"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          {t(lang, "posts.backToAll")}
        </a>
        
        <button
          id="scroll-to-top"
          class="inline-flex items-center gap-2 text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors text-sm"
        >
          {t(lang, "posts.top")}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </button>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  function initPreviewCards() {
    const previewEl = document.getElementById('wikilink-previews');
    const card = document.getElementById('wikilink-preview-card');
    if (!previewEl || !card) return;

    let previews: Record<string, { title: string; description: string; excerpt: string }>;
    try {
      previews = JSON.parse(previewEl.textContent || '{}');
    } catch { return; }

    let hideTimeout: ReturnType<typeof setTimeout> | null = null;

    function showCard(anchor: HTMLElement) {
      const slug = anchor.dataset.slug;
      if (!slug || !previews[slug]) return;
      if (anchor.classList.contains('wikilink--broken')) return;

      const p = previews[slug];
      card!.querySelector('.preview-title')!.textContent = p.title;
      card!.querySelector('.preview-desc')!.textContent = p.description;
      card!.querySelector('.preview-excerpt')!.textContent = p.excerpt;

      const rect = anchor.getBoundingClientRect();
      const scrollY = window.scrollY;
      const scrollX = window.scrollX;

      let top = rect.bottom + scrollY + 8;
      let left = rect.left + scrollX;

      card!.classList.add('visible');

      const cardRect = card!.getBoundingClientRect();
      if (rect.bottom + cardRect.height + 16 > window.innerHeight) {
        top = rect.top + scrollY - cardRect.height - 8;
      }
      if (left + cardRect.width > window.innerWidth - 16) {
        left = window.innerWidth - cardRect.width - 16 + scrollX;
      }

      card!.style.top = `${top}px`;
      card!.style.left = `${left}px`;
    }

    function hideCard() {
      hideTimeout = setTimeout(() => {
        card!.classList.remove('visible');
      }, 150);
    }

    function cancelHide() {
      if (hideTimeout) { clearTimeout(hideTimeout); hideTimeout = null; }
    }

    document.querySelectorAll<HTMLAnchorElement>('a.wikilink:not(.wikilink--broken)').forEach(a => {
      a.addEventListener('mouseenter', () => { cancelHide(); showCard(a); });
      a.addEventListener('mouseleave', hideCard);
    });

    card.addEventListener('mouseenter', cancelHide);
    card.addEventListener('mouseleave', hideCard);
  }

  initPreviewCards();
  document.addEventListener('astro:after-swap', initPreviewCards);

  document.getElementById("scroll-to-top")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  // Reading progress bar
  const progressBar = document.getElementById("reading-progress");
  if (progressBar) {
    const updateProgress = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(progress, 100)}%`;
    };
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
    document.addEventListener("astro:after-swap", () => {
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    });
  }
</script>

<style>
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  html:not(.dark) .article-meta {
    color: var(--color-light-text-muted);
  }

  .article-meta span::before {
    content: " · ";
  }

  .meta-series {
    font-style: italic;
  }

  .meta-noteid {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .meta-category {
    font-style: italic;
  }

  .article-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin-bottom: 0.6rem;
    letter-spacing: 0.01em;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.25rem;
    }
  }

  html:not(.dark) .article-title {
    color: var(--color-light-text-primary);
  }

  .article-desc {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 60ch;
  }

  html:not(.dark) .article-desc {
    color: var(--color-light-text-secondary);
  }

  html:not(.dark) footer {
    border-color: var(--color-light-border);
  }

  html:not(.dark) #scroll-to-top {
    color: var(--color-light-text-muted);
  }

  html:not(.dark) #scroll-to-top:hover {
    color: var(--color-light-text-primary);
  }

  /* Title row — title + translate button side by side */
  .article-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .article-title-row .article-title {
    margin-bottom: 0;
    flex: 1;
    min-width: 0;
  }

  /* Translate button */
  .translate-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    text-decoration: none;
    transition: all 200ms ease;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 0.5rem;
  }

  .translate-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-muted);
    background-color: rgba(155, 123, 91, 0.08);
  }

  .translate-icon {
    flex-shrink: 0;
  }

  html:not(.dark) .translate-btn {
    color: var(--color-light-text-muted);
    background-color: var(--color-light-bg-tertiary);
    border-color: var(--color-light-border);
  }

  html:not(.dark) .translate-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-muted);
    background-color: rgba(155, 123, 91, 0.06);
  }
</style>
