---
import BaseLayout from "./BaseLayout.astro";
import type { Lang } from "../i18n/translations";
import { seriesNames, categoryNames } from "../i18n/translations";
import { t, formatDate, getLangFromUrl, localizedPath } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  image?: {
    url: string;
    alt: string;
  };
  type?: "core" | "marginalia";
  series?: string;
  noteId?: string;
  category?: string;
  lang?: Lang;
  sourceLang?: Lang;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = "Anonymous",
  tags = [],
  image,
  type = "core",
  series,
  noteId,
  category,
} = Astro.props;

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const sourceLang = Astro.props.sourceLang || lang;
const seriesMap = seriesNames[lang];
const categoryMap = categoryNames[lang];

const formattedPubDate = formatDate(pubDate, lang);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate, lang) : null;

const seriesLabel = series ? seriesMap[series] || series : null;
const categoryLabel = category ? categoryMap[category] || category : null;

// Determine translate button label based on source language
const translateLabel = sourceLang === "zh" ? t(lang, "translate.button") : t(lang, "translate.button");
---

<BaseLayout
  title={title}
  description={description}
  image={image?.url}
  article={true}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
  lang={lang}
>
  <div class="reading-progress" id="reading-progress"></div>
  <article class="container-narrow py-12 md:py-16">
    <header class="mb-10">
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>
          {formattedPubDate}
        </time>
        {formattedUpdatedDate && (
          <span>{t(lang, "posts.updated")} {formattedUpdatedDate}</span>
        )}
        {type === "core" && seriesLabel && (
          <span class="meta-series">{seriesLabel}</span>
        )}
        {type === "core" && noteId && (
          <span class="meta-noteid">{noteId}</span>
        )}
        {type === "marginalia" && categoryLabel && (
          <span class="meta-category">{categoryLabel}</span>
        )}
      </div>

      <div class="article-title-row">
        <h1 class="article-title">
          {title}
        </h1>
        <button
          id="translate-btn"
          class="translate-btn"
          data-source-lang={sourceLang}
          data-page-lang={lang}
          data-text-translate={sourceLang === "zh" ? (lang === "zh" ? "翻译为英文" : "Translate to English") : (lang === "zh" ? "翻译为中文" : "Translate to Chinese")}
          data-text-back={t(lang, "translate.buttonBack")}
          data-text-loading={t(lang, "translate.loading")}
          data-text-error={t(lang, "translate.error")}
          data-text-powered={t(lang, "translate.poweredBy")}
        >
          <svg class="translate-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 8l6 6" />
            <path d="M4 14l6-6 2-3" />
            <path d="M2 5h12" />
            <path d="M7 2v3" />
            <path d="M22 22l-5-10-5 10" />
            <path d="M14 18h6" />
          </svg>
          <span class="translate-btn-text">{sourceLang === "zh" ? (lang === "zh" ? "翻译为英文" : "Translate to English") : (lang === "zh" ? "翻译为中文" : "Translate to Chinese")}</span>
        </button>
      </div>
      
      <p class="article-desc">
        {description}
      </p>
    </header>
    
    {image && (
      <figure class="mb-12">
        <img
          src={image.url}
          alt={image.alt}
          class="w-full rounded-sm"
        />
        {image.alt && (
          <figcaption class="text-center text-sm text-[var(--color-text-muted)] mt-3">
            {image.alt}
          </figcaption>
        )}
      </figure>
    )}
    
    <div class="prose">
      <slot />
    </div>
    <div class="translate-attribution hidden" id="translate-attribution">
      {t(lang, "translate.poweredBy")}
    </div>
    
    <footer class="mt-16 pt-8 border-t border-[var(--color-border)]">
      <div class="flex items-center justify-between">
        <a
          href={localizedPath(lang, "/")}
          class="inline-flex items-center gap-2 text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors text-sm"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          {t(lang, "posts.backToAll")}
        </a>
        
        <button
          id="scroll-to-top"
          class="inline-flex items-center gap-2 text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors text-sm"
        >
          {t(lang, "posts.top")}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </button>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  function initPostPage() {
    // Scroll to top
    document.getElementById("scroll-to-top")?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    // Reading progress bar
    const progressBar = document.getElementById("reading-progress");
    if (progressBar) {
      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = `${Math.min(progress, 100)}%`;
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    }

    // ── Translation Logic ──────────────────────────────────────────────
    const translateBtn = document.getElementById("translate-btn") as HTMLButtonElement | null;
    const proseEl = document.querySelector(".prose") as HTMLElement | null;
    const attribution = document.getElementById("translate-attribution");
    const btnText = translateBtn?.querySelector(".translate-btn-text");

    if (!translateBtn || !proseEl || !btnText) return;

    let originalContent: string | null = null;
    let isTranslated = false;

    const textTranslate = translateBtn.dataset.textTranslate || "Translate";
    const textBack = translateBtn.dataset.textBack || "Show original";
    const textLoading = translateBtn.dataset.textLoading || "Translating...";
    const textError = translateBtn.dataset.textError || "Translation failed";
    const sourceLang = translateBtn.dataset.sourceLang || "zh";

    // Determine target language (opposite of source)
    const targetLang = sourceLang === "zh" ? "EN" : "ZH";

    translateBtn.addEventListener("click", async () => {
      // Toggle back to original
      if (isTranslated && originalContent !== null) {
        proseEl.innerHTML = originalContent;
        originalContent = null;
        isTranslated = false;
        btnText.textContent = textTranslate;
        translateBtn.classList.remove("translated");
        attribution?.classList.add("hidden");
        return;
      }

      // Save original and start translating
      originalContent = proseEl.innerHTML;
      translateBtn.disabled = true;
      translateBtn.classList.add("loading");
      btnText.textContent = textLoading;

      try {
        const res = await fetch("/api/translate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            text: originalContent,
            sourceLang: sourceLang.toUpperCase(),
            targetLang,
          }),
        });

        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }

        const data = await res.json();

        if (data.translatedText) {
          proseEl.innerHTML = data.translatedText;
          isTranslated = true;
          btnText.textContent = textBack;
          translateBtn.classList.add("translated");
          attribution?.classList.remove("hidden");
        } else {
          throw new Error("Empty translation");
        }
      } catch (err) {
        console.error("Translation error:", err);
        // Restore original on error
        if (originalContent) {
          proseEl.innerHTML = originalContent;
          originalContent = null;
        }
        btnText.textContent = textError;
        translateBtn.classList.add("error");
        setTimeout(() => {
          btnText.textContent = textTranslate;
          translateBtn.classList.remove("error");
        }, 3000);
      } finally {
        translateBtn.disabled = false;
        translateBtn.classList.remove("loading");
      }
    });
  }

  // Run on initial load
  initPostPage();
  // Re-run after View Transitions navigation
  document.addEventListener("astro:after-swap", initPostPage);
</script>

<style>
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  html:not(.dark) .article-meta {
    color: var(--color-light-text-muted);
  }

  .article-meta span::before {
    content: " · ";
  }

  .meta-series {
    font-style: italic;
  }

  .meta-noteid {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .meta-category {
    font-style: italic;
  }

  .article-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin-bottom: 0.6rem;
    letter-spacing: 0.01em;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.25rem;
    }
  }

  html:not(.dark) .article-title {
    color: var(--color-light-text-primary);
  }

  .article-desc {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 60ch;
  }

  html:not(.dark) .article-desc {
    color: var(--color-light-text-secondary);
  }

  html:not(.dark) footer {
    border-color: var(--color-light-border);
  }

  html:not(.dark) #scroll-to-top {
    color: var(--color-light-text-muted);
  }

  html:not(.dark) #scroll-to-top:hover {
    color: var(--color-light-text-primary);
  }

  /* Title row — title + translate button side by side */
  .article-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .article-title-row .article-title {
    margin-bottom: 0;
    flex: 1;
    min-width: 0;
  }

  /* Translate button */
  .translate-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    cursor: pointer;
    transition: all 200ms ease;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 0.5rem;
  }

  .translate-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-muted);
    background-color: rgba(155, 123, 91, 0.08);
  }

  .translate-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .translate-btn.loading {
    animation: pulse 1.5s ease-in-out infinite;
  }

  .translate-btn.translated {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: rgba(155, 123, 91, 0.1);
  }

  .translate-btn.error {
    color: #c4584a;
    border-color: #c4584a40;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .translate-icon {
    flex-shrink: 0;
  }

  html:not(.dark) .translate-btn {
    color: var(--color-light-text-muted);
    background-color: var(--color-light-bg-tertiary);
    border-color: var(--color-light-border);
  }

  html:not(.dark) .translate-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-muted);
    background-color: rgba(155, 123, 91, 0.06);
  }

  html:not(.dark) .translate-btn.translated {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: rgba(155, 123, 91, 0.08);
  }

  /* Translation attribution */
  .translate-attribution {
    margin-top: 1rem;
    padding: 0.5rem 0;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
    text-align: right;
  }

  html:not(.dark) .translate-attribution {
    color: var(--color-light-text-muted);
  }

  .hidden {
    display: none !important;
  }
</style>
