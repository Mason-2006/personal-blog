---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { Lang } from "../../i18n/translations";
import { seriesNames } from "../../i18n/translations";
import { t, formatDayMonth, getMonthName } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Group posts by year → month
type PostEntry = (typeof sortedPosts)[number];
const grouped = new Map<number, Map<string, PostEntry[]>>();

for (const post of sortedPosts) {
  const year = post.data.pubDate.getFullYear();
  const month = getMonthName(post.data.pubDate, lang);

  if (!grouped.has(year)) grouped.set(year, new Map());
  const yearMap = grouped.get(year)!;
  if (!yearMap.has(month)) yearMap.set(month, []);
  yearMap.get(month)!.push(post);
}

const series = seriesNames[lang];

// Build search index data for client-side search
const searchIndex = sortedPosts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  slug: post.id,
  type: post.data.type,
  series: post.data.series ? series[post.data.series] || post.data.series : "",
}));
---

<BaseLayout
  title={t(lang, "home.title")}
  description={t(lang, "home.subtitle")}
  lang={lang}
>
  <section class="container-narrow py-12 md:py-16">
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-display text-[var(--color-text-primary)] mb-3" style="font-family: var(--font-display); font-weight: 500;">
        {t(lang, "home.title")}
      </h1>
      <p class="text-[var(--color-text-secondary)]" style="max-width: 50ch;">
        {t(lang, "home.subtitle")}
      </p>
    </header>

    <!-- Search Bar -->
    <div class="search-container mb-10">
      <div class="search-wrapper">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder={t(lang, "search.placeholder")}
          autocomplete="off"
          aria-label={t(lang, "search.label")}
        />
        <button id="search-clear" class="search-clear hidden" type="button" aria-label="Clear search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
      <!-- Search results container -->
      <div id="search-results" class="search-results hidden"></div>
      <p id="search-no-results" class="search-no-results hidden">{t(lang, "search.noResults")}</p>
    </div>

    <!-- Timeline (default view) -->
    <div id="timeline-view">
      {grouped.size > 0 ? (
        <div class="timeline">
          {[...grouped.entries()].map(([year, months]) => (
            <section class="year-group">
              <h2 class="year-heading">{year}</h2>
              {[...months.entries()].map(([month, posts]) => (
                <div class="month-group">
                  <h3 class="month-heading">{month}</h3>
                  <div class="post-list">
                    {posts.map((post) => {
                      const seriesLabel = post.data.series ? series[post.data.series] || post.data.series : null;
                      const typeLabel = post.data.type === "marginalia" ? t(lang, "nav.marginalia") : null;
                      return (
                        <article class="post-item">
                          <div class="post-meta">
                            <time datetime={post.data.pubDate.toISOString()}>
                              {formatDayMonth(post.data.pubDate, lang)}
                            </time>
                            {seriesLabel && (
                              <span class="post-series">{seriesLabel}</span>
                            )}
                            {typeLabel && !seriesLabel && (
                              <span class="post-series">{typeLabel}</span>
                            )}
                            {post.data.lang !== lang && (
                              <span class="post-lang">{post.data.lang.toUpperCase()}</span>
                            )}
                          </div>
                          <h4 class="post-title">
                            <a href={`/${lang}/posts/${post.id}`}>{post.data.title}</a>
                          </h4>
                          <p class="post-desc">{post.data.description}</p>
                        </article>
                      );
                    })}
                  </div>
                </div>
              ))}
            </section>
          ))}
        </div>
      ) : (
        <p class="text-[var(--color-text-muted)]">{t(lang, "posts.noPosts")}</p>
      )}
    </div>
  </section>
</BaseLayout>

<!-- Inline search index data -->
<script is:inline define:vars={{ searchIndex, lang }}>
  (function () {
    const input = document.getElementById("search-input");
    const clearBtn = document.getElementById("search-clear");
    const resultsContainer = document.getElementById("search-results");
    const noResultsEl = document.getElementById("search-no-results");
    const timelineView = document.getElementById("timeline-view");

    if (!input || !clearBtn || !resultsContainer || !noResultsEl || !timelineView) return;

    function normalize(str) {
      return str.toLowerCase().trim();
    }

    function matchesQuery(post, query) {
      const q = normalize(query);
      return (
        normalize(post.title).includes(q) ||
        normalize(post.description).includes(q) ||
        post.tags.some(function (tag) { return normalize(tag).includes(q); }) ||
        normalize(post.series).includes(q)
      );
    }

    function renderResults(matches) {
      if (matches.length === 0) {
        resultsContainer.classList.add("hidden");
        resultsContainer.innerHTML = "";
        noResultsEl.classList.remove("hidden");
        timelineView.classList.add("hidden");
        return;
      }

      noResultsEl.classList.add("hidden");
      timelineView.classList.add("hidden");

      var html = "";
      for (var i = 0; i < matches.length; i++) {
        var post = matches[i];
        var typeClass = post.type === "marginalia" ? "result-type-marginalia" : "result-type-core";
        html += '<article class="result-item">';
        html += '<div class="result-meta">';
        html += '<span class="result-type ' + typeClass + '">' + (post.type === "marginalia" ? (lang === "zh" ? "随记" : "Marginalia") : (lang === "zh" ? "笔记" : "Note")) + '</span>';
        if (post.series) {
          html += '<span class="result-series">' + post.series + '</span>';
        }
        html += '</div>';
        html += '<h4 class="result-title"><a href="/' + lang + '/posts/' + post.slug + '">' + post.title + '</a></h4>';
        html += '<p class="result-desc">' + post.description + '</p>';
        html += '</article>';
      }

      resultsContainer.innerHTML = html;
      resultsContainer.classList.remove("hidden");
    }

    function handleSearch() {
      var query = input.value.trim();

      if (query.length > 0) {
        clearBtn.classList.remove("hidden");
      } else {
        clearBtn.classList.add("hidden");
      }

      if (query.length === 0) {
        resultsContainer.classList.add("hidden");
        resultsContainer.innerHTML = "";
        noResultsEl.classList.add("hidden");
        timelineView.classList.remove("hidden");
        return;
      }

      var matches = searchIndex.filter(function (post) {
        return matchesQuery(post, query);
      });

      renderResults(matches);
    }

    var debounceTimer = null;
    input.addEventListener("input", function () {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(handleSearch, 150);
    });

    clearBtn.addEventListener("click", function () {
      input.value = "";
      clearBtn.classList.add("hidden");
      resultsContainer.classList.add("hidden");
      resultsContainer.innerHTML = "";
      noResultsEl.classList.add("hidden");
      timelineView.classList.remove("hidden");
      input.focus();
    });
  })();
</script>

<style>
  /* Search */
  .search-container {
    position: relative;
  }

  .search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  html:not(.dark) .search-icon {
    color: var(--color-light-text-muted);
  }

  .search-input {
    width: 100%;
    padding: 0.65rem 2.5rem 0.65rem 2.75rem;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-text-primary);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    outline: none;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  html:not(.dark) .search-input {
    color: var(--color-light-text-primary);
    background-color: var(--color-light-bg-secondary);
    border-color: var(--color-light-border);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  html:not(.dark) .search-input::placeholder {
    color: var(--color-light-text-muted);
  }

  .search-input:focus {
    border-color: var(--color-accent);
  }

  .search-clear {
    position: absolute;
    right: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 0.25rem;
    transition: color 200ms ease;
  }

  .search-clear:hover {
    color: var(--color-text-primary);
  }

  html:not(.dark) .search-clear {
    color: var(--color-light-text-muted);
  }

  html:not(.dark) .search-clear:hover {
    color: var(--color-light-text-primary);
  }

  .search-results {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .search-no-results {
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  html:not(.dark) .search-no-results {
    color: var(--color-light-text-muted);
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .year-group {
    display: flex;
    flex-direction: column;
  }

  .year-heading {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  html:not(.dark) .year-heading {
    color: var(--color-light-text-primary);
  }

  .month-group {
    margin-bottom: 2rem;
  }

  .month-group:last-child {
    margin-bottom: 0;
  }

  .month-heading {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    font-style: italic;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    padding-left: 0.5rem;
    border-left: 2px solid var(--color-accent-muted);
  }

  html:not(.dark) .month-heading {
    color: var(--color-light-text-secondary);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-left: 1rem;
  }

  .post-item {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  html:not(.dark) .post-item {
    border-bottom-color: var(--color-light-border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  html:not(.dark) .post-meta {
    color: var(--color-light-text-muted);
  }

  .post-series {
    font-style: italic;
  }

  .post-series::before {
    content: " · ";
    font-style: normal;
  }

  .post-lang {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.1rem 0.35rem;
    border-radius: 0.2rem;
    background-color: var(--color-bg-tertiary);
  }

  html:not(.dark) .post-lang {
    background-color: var(--color-light-bg-tertiary);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.35;
    margin-bottom: 0.35rem;
  }

  .post-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .post-title a:hover {
    color: var(--color-accent);
  }

  html:not(.dark) .post-title a {
    color: var(--color-light-text-primary);
  }

  html:not(.dark) .post-title a:hover {
    color: var(--color-accent);
  }

  .post-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 60ch;
  }

  html:not(.dark) .post-desc {
    color: var(--color-light-text-secondary);
  }

  .hidden {
    display: none !important;
  }
</style>

<!-- Dynamic search result styles (for innerHTML-generated content) -->
<style is:global>
  .result-item {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .result-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  html:not(.dark) .result-item {
    border-bottom-color: var(--color-light-border);
  }

  .result-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    font-size: 0.8rem;
  }

  .result-type {
    padding: 0.1rem 0.4rem;
    border-radius: 0.2rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .result-type-core {
    background-color: var(--color-accent)/15;
    color: var(--color-accent);
  }

  .result-type-marginalia {
    background-color: #9b9b5b20;
    color: #9b9b5b;
  }

  .result-series {
    font-style: italic;
    color: var(--color-text-muted);
  }

  html:not(.dark) .result-series {
    color: var(--color-light-text-muted);
  }

  .result-series::before {
    content: " · ";
    font-style: normal;
  }

  .result-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
    margin-bottom: 0.25rem;
  }

  .result-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .result-title a:hover {
    color: var(--color-accent);
  }

  html:not(.dark) .result-title a {
    color: var(--color-light-text-primary);
  }

  html:not(.dark) .result-title a:hover {
    color: var(--color-accent);
  }

  .result-desc {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 60ch;
  }

  html:not(.dark) .result-desc {
    color: var(--color-light-text-secondary);
  }
</style>
