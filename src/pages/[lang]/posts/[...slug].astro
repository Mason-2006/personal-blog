---
import { render } from "astro:content";
import PostLayout from "../../../layouts/PostLayout.astro";
import type { Lang } from "../../../i18n/translations";
import { buildTranslationMap, getBaseSlug } from "../../../lib/i18n-posts";

export async function getStaticPaths() {
  const translationMap = await buildTranslationMap();
  const paths = [];

  for (const [baseSlug, langMap] of translationMap) {
    for (const [lang, post] of langMap) {
      const otherLang: Lang = lang === "zh" ? "en" : "zh";
      const hasTranslation = langMap.has(otherLang);
      paths.push({
        params: { lang, slug: baseSlug },
        props: { post, lang, hasTranslation, baseSlug },
      });
    }
  }

  return paths;
}

const { post, lang, hasTranslation, baseSlug } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  tags={post.data.tags}
  image={post.data.image}
  type={post.data.type}
  series={post.data.series}
  noteId={post.data.noteId}
  category={post.data.category}
  lang={lang as Lang}
  hasTranslation={hasTranslation}
  baseSlug={baseSlug}
>
  <Content />
</PostLayout>
