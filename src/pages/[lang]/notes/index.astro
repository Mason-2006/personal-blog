---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { Lang } from "../../../i18n/translations";
import { seriesNames } from "../../../i18n/translations";
import { t, formatDate } from "../../../i18n/utils";
import { getPostsByLang, getBaseSlug } from "../../../lib/i18n-posts";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;

const allPosts = await getPostsByLang(lang);
const coreNotes = allPosts
  .filter((p) => p.data.type === "core")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const series = seriesNames[lang];

// Group by series
const grouped = new Map<string, typeof coreNotes>();
for (const post of coreNotes) {
  const key = post.data.series || "Uncategorised";
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(post);
}
---

<BaseLayout
  title={t(lang, "notes.title")}
  description={t(lang, "notes.subtitle")}
  lang={lang}
>
  <section class="container-narrow py-12 md:py-16">
    <header class="mb-12">
      <h1 class="page-heading text-3xl md:text-4xl mb-3">
        {t(lang, "notes.title")}
      </h1>
      <p class="page-subtitle" style="max-width: 50ch;">
        {t(lang, "notes.subtitle")}
      </p>
    </header>

    {grouped.size > 0 ? (
      <div class="series-list">
        {[...grouped.entries()].map(([seriesKey, posts]) => (
          <details class="series-accordion" open>
            <summary class="series-header">
              <div class="series-header-left">
                <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6" />
                </svg>
                <h2 class="series-heading">{series[seriesKey] || seriesKey}</h2>
              </div>
              <span class="series-count">{posts.length} {t(lang, "notes.entriesCount")}</span>
            </summary>
            <ul class="note-list">
              {posts.map((post) => (
                <li class="note-item">
                  <a href={`/${lang}/posts/${getBaseSlug(post.id)}`} class="note-link">
                    <span class="note-id">{post.data.noteId || ""}</span>
                    <span class="note-title">{post.data.title}</span>
                    <span class="note-date">{formatDate(post.data.pubDate, lang)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    ) : (
      <p class="text-[var(--color-text-muted)]">{t(lang, "posts.noCorePosts")}</p>
    )}
  </section>
</BaseLayout>

<style>
  .series-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .series-accordion {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    transition: border-color 200ms ease;
  }

  .series-accordion:hover {
    border-color: var(--color-accent-muted);
  }

  html:not(.dark) .series-accordion {
    border-color: var(--color-light-border);
  }

  html:not(.dark) .series-accordion:hover {
    border-color: var(--color-accent-muted);
  }

  .series-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    cursor: pointer;
    background-color: var(--color-bg-secondary);
    transition: background-color 200ms ease;
    list-style: none;
    user-select: none;
  }

  .series-header::-webkit-details-marker {
    display: none;
  }

  .series-header::marker {
    display: none;
    content: "";
  }

  .series-header:hover {
    background-color: var(--color-bg-tertiary);
  }

  html:not(.dark) .series-header {
    background-color: var(--color-light-bg-secondary);
  }

  html:not(.dark) .series-header:hover {
    background-color: var(--color-light-bg-tertiary);
  }

  .series-header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .accordion-chevron {
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform 200ms ease;
  }

  html:not(.dark) .accordion-chevron {
    color: var(--color-light-text-muted);
  }

  .series-accordion[open] .accordion-chevron {
    transform: rotate(90deg);
  }

  .series-heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: 0.01em;
  }

  html:not(.dark) .series-heading {
    color: var(--color-light-text-primary);
  }

  .series-count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  html:not(.dark) .series-count {
    color: var(--color-light-text-muted);
  }

  .note-list {
    list-style: none;
    padding: 0.5rem 1.25rem 1rem;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  html:not(.dark) .note-list {
    border-top-color: var(--color-light-border);
  }

  .note-item {
    margin-bottom: 0;
  }

  .note-link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.5rem 0;
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: color 200ms ease;
  }

  .note-link:hover {
    color: var(--color-accent);
  }

  html:not(.dark) .note-link {
    color: var(--color-light-text-secondary);
  }

  html:not(.dark) .note-link:hover {
    color: var(--color-accent);
  }

  .note-id {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    min-width: 5ch;
    flex-shrink: 0;
  }

  html:not(.dark) .note-id {
    color: var(--color-light-text-muted);
  }

  .note-title {
    flex: 1;
  }

  .note-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  html:not(.dark) .note-date {
    color: var(--color-light-text-muted);
  }

  .page-heading {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  html:not(.dark) .page-heading {
    color: var(--color-light-text-primary);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
  }

  html:not(.dark) .page-subtitle {
    color: var(--color-light-text-secondary);
  }
</style>
