---
import type { Lang } from "../i18n/translations";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] mt-auto">
  <div class="container-narrow py-8">
    <div class="flex items-center justify-between">
      <p class="text-sm text-[var(--color-text-muted)]">
        &copy; {currentYear} {lang === "zh" ? "泊桥" : "Mooringbridge"}
      </p>
      
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/Mason-2006"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
        
        <a
          href="/rss.xml"
          class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
          aria-label="RSS Feed"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 012.18 2.18C8.36 19 7.38 20 6.18 20c-1.2 0-2.18-.98-2.18-2.18 0-1.2.98-2.18 2.18-2.18M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93v-2.83z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  html:not(.dark) footer {
    border-color: var(--color-light-border);
  }
  
  html:not(.dark) footer p {
    color: var(--color-light-text-muted);
  }
  
  html:not(.dark) footer a {
    color: var(--color-light-text-muted);
  }
</style>
