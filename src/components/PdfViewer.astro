---
interface Props {
  src: string;
  title?: string;
}

const { src, title } = Astro.props;
---

<div class="pdf-viewer-wrapper">
  <div class="pdf-toolbar">
    <span class="pdf-label">PDF</span>
    <a href={src} target="_blank" rel="noopener noreferrer" class="pdf-open-link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        <polyline points="15 3 21 3 21 9" />
        <line x1="10" y1="14" x2="21" y2="3" />
      </svg>
      {title ? title : ''}
    </a>
  </div>
  <iframe
    src={src}
    title={title || 'PDF document'}
    class="pdf-frame"
    loading="lazy"
  ></iframe>
</div>

<style>
  .pdf-viewer-wrapper {
    margin: 2em 0;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    overflow: hidden;
  }

  html:not(.dark) .pdf-viewer-wrapper {
    border-color: var(--color-light-border);
  }

  .pdf-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  html:not(.dark) .pdf-toolbar {
    background-color: var(--color-light-bg-secondary);
    border-bottom-color: var(--color-light-border);
  }

  .pdf-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .pdf-open-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .pdf-open-link:hover {
    color: var(--color-accent);
  }

  html:not(.dark) .pdf-open-link {
    color: var(--color-light-text-muted);
  }

  html:not(.dark) .pdf-open-link:hover {
    color: var(--color-accent);
  }

  .pdf-frame {
    width: 100%;
    height: 85vh;
    border: none;
    display: block;
    background-color: var(--color-bg-tertiary);
  }

  html:not(.dark) .pdf-frame {
    background-color: var(--color-light-bg-tertiary);
  }
</style>
