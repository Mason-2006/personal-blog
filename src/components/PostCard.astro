---
import type { Lang } from "../i18n/translations";
import { t, formatDate, getLangFromUrl } from "../i18n/utils";
import { getBaseSlug } from "../lib/i18n-posts";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  slug: string;
  lang?: Lang;
}

const { title, description, pubDate, tags = [], slug } = Astro.props;
const cleanSlug = slug.includes("/") ? getBaseSlug(slug) : slug;
const lang = Astro.props.lang || getLangFromUrl(Astro.url);

const formattedDate = formatDate(pubDate, lang);
---

<article class="group">
  <a
    href={`/${lang}/posts/${cleanSlug}`}
    class="block p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)] hover:border-[var(--color-accent)]/50 hover:bg-[var(--color-bg-tertiary)] transition-all duration-200"
  >
    <div class="flex flex-col gap-3">
      <time
        datetime={pubDate.toISOString()}
        class="text-sm text-[var(--color-text-muted)]"
      >
        {formattedDate}
      </time>
      
      <h2 class="text-xl font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors line-clamp-2">
        {title}
      </h2>
      
      <p class="text-[var(--color-text-secondary)] line-clamp-3">
        {description}
      </p>
      
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-2">
          {tags.map((tag) => (
            <span class="px-2 py-1 text-xs rounded-md bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
              #{tag}
            </span>
          ))}
        </div>
      )}
      
      <span class="inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)] mt-2">
        {t(lang, "posts.readMore")}
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  html:not(.dark) article a {
    border-color: var(--color-light-border);
    background-color: var(--color-light-bg-secondary);
  }
  
  html:not(.dark) article a:hover {
    border-color: rgba(59, 130, 246, 0.5);
    background-color: var(--color-light-bg-tertiary);
  }
  
  html:not(.dark) time {
    color: var(--color-light-text-muted);
  }
  
  html:not(.dark) h2 {
    color: var(--color-light-text-primary);
  }
  
  html:not(.dark) p {
    color: var(--color-light-text-secondary);
  }
</style>
