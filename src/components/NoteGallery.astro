---
interface Props {
  folder: string;
  images: string[];
}

const { folder, images } = Astro.props;
---

<div class="note-gallery">
  {images.map((img, i) => (
    <figure class="note-page">
      <span class="note-page-num">{i + 1} / {images.length}</span>
      <img
        src={`${folder}/${img}`}
        alt={`Page ${i + 1}`}
        loading={i === 0 ? "eager" : "lazy"}
        decoding="async"
      />
    </figure>
  ))}
</div>

<style>
  .note-gallery {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 2em 0;
  }

  .note-page {
    position: relative;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    overflow: hidden;
  }

  html:not(.dark) .note-page {
    border-color: var(--color-light-border);
  }

  .note-page img {
    display: block;
    width: 100%;
    height: auto;
  }

  .note-page-num {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    background-color: rgba(0, 0, 0, 0.5);
    color: #e8e4dc;
    border-radius: 0.25rem;
    pointer-events: none;
  }
</style>
